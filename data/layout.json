{
  "siteTitle": "My Custom Site",
  "global": {
    "background": "#f8fafc",
    "textColor": "#111827",
    "fontFamily": "Inter, Arial, sans-serif",
    "maxWidth": 1200,
    "accentColor": "#2563eb",
    "heroGradient": "linear-gradient(135deg, #2563eb 0%, #7c3aed 100%)"
  },
  "elements": [
    {
      "id": "hero-title",
      "type": "heading",
      "text": "Build your dream website visually",
      "x": 80,
      "y": 80,
      "width": 700,
      "height": 80,
      "style": {
        "color": "#ffffff",
        "fontSize": 52,
        "fontWeight": 800,
        "padding": 8,
        "background": "transparent",
        "borderRadius": 0,
        "textAlign": "left"
      }
    },
    {
      "id": "hero-subtitle",
      "type": "paragraph",
      "text": "Drag, drop, and publish pages without touching code.",
      "x": 80,
      "y": 180,
      "width": 640,
      "height": 52,
      "style": {
        "color": "#e0e7ff",
        "fontSize": 24,
        "fontWeight": 500,
        "padding": 6,
        "background": "transparent",
        "borderRadius": 0,
        "textAlign": "left"
      }
    },
    {
      "id": "cta-button",
      "type": "button",
      "text": "Start your project",
      "x": 80,
      "y": 270,
      "width": 220,
      "height": 56,
      "style": {
        "color": "#ffffff",
        "fontSize": 18,
        "fontWeight": 700,
        "padding": 10,
        "background": "#ef4444",
        "borderRadius": 12,
        "textAlign": "center"
      }
    }
  ]
}
